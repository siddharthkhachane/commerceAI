# Copy to .env in the backend directory (or use root .env values)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/commerceai
SPRING_DATASOURCE_USERNAME=commerceai
SPRING_DATASOURCE_PASSWORD=commerceai
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=commerceai-dev-secret-key-must-be-at-least-32-chars
JWT_EXPIRATION_MS=604800000
